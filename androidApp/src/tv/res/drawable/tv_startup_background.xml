<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#050507" />
        </shape>
    </item>

    <item
        android:width="70dp"
        android:gravity="start|fill_vertical"
        android:start="16dp"
        android:top="28dp"
        android:bottom="28dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#B315151B" />
            <stroke
                android:width="1dp"
                android:color="#18FFFFFF" />
        </shape>
    </item>

    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="start|top"
        android:start="39dp"
        android:top="46dp">
        <shape android:shape="oval">
            <solid android:color="#D9F5B133" />
        </shape>
    </item>
</layer-list>
