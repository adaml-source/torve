<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Google Cast (only for Google Play builds) -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.streamvault.android.player.CastOptionsProvider" />

        <!-- Continue Watching Widget (only for Google Play builds) -->
        <receiver
            android:name=".widget.ContinueWatchingWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/continue_watching_widget_info" />
        </receiver>
    </application>
</manifest>
