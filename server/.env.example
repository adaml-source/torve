# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_PUBLIC_WEB_URL=https://example.com
APP_PUBLIC_API_URL=https://api.example.com

# Database
DATABASE_URL=postgresql://torve_user:change-me@localhost:5432/torve

# Auth
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Email (Resend)
RESEND_API_KEY=re_change-me
MAIL_FROM=noreply@example.com
SUPPORT_EMAIL=support@torve.app

# Paddle billing
PADDLE_ADMIN_SECRET=change-me

# Google Play billing
GOOGLE_PLAY_PACKAGE_NAME=com.example.app
GOOGLE_PLAY_LIFETIME_PRODUCT_ID=lifetime_access
GOOGLE_PLAY_SUBSCRIPTION_ID=premium_monthly
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={}

# Google Play review account (optional)
GOOGLE_PLAY_REVIEW_ENABLED=false
GOOGLE_PLAY_REVIEW_EMAIL=
GOOGLE_PLAY_REVIEW_PASSWORD=
GOOGLE_PLAY_REVIEW_DISPLAY_NAME=

# Integration / encryption secrets
INTEGRATION_SECRET_KEY=change-me
REBATE_CODE_HMAC_SECRET=change-me

# Observability (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
